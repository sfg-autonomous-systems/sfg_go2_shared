<?xml version="1.0"?>
<robot name="go2" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="go2_robot_description" params="name:='base_link' parent:='' *origin">
    <xacro:include filename="$(find sfg_go2_description)/xacro/constants.xacro" />
    <xacro:include filename="$(find sfg_go2_description)/xacro/leg.xacro" />

    <xacro:include filename="$(find sfg_peripherals_description)/xacro/base_marker_tree.xacro" />
    <xacro:include filename="$(find sfg_peripherals_description)/xacro/intel_realsense_d435.xacro" />
    <xacro:include filename="$(find sfg_peripherals_description)/xacro/livox_mid360.xacro" />

    <xacro:if value="${parent != ''}">
      <joint name="${name}_joint" type="fixed">
        <parent link="${parent}" />
        <child link="${name}" />
        <xacro:insert_block name="origin" />
      </joint>
    </xacro:if>

    <link name="${name}">
      <visual>
        <origin xyz="0 0 0" rpy="${0.5 * pi} 0 0" />
        <geometry>
          <mesh filename="package://sfg_go2_description/mesh/base_link.glb" />
        </geometry>
      </visual>
    </link>

    <!-- builtin imu -->
    <!-- Taken from
    https://github.com/unitreerobotics/unitree_ros/blob/master/robots/go2_description/urdf/go2_description.urdf#L728-L740. -->
    <joint name="imu_joint" type="fixed">
      <parent link="base_link" />
      <child link="imu_frame" />
      <origin xyz="-0.02557 0 0.04232" rpy="0 0 0" />
    </joint>

    <link name="imu_frame" />

    <!-- legs -->
    <xacro:leg name="front_left" front="1" left="1" />
    <xacro:leg name="front_right" front="1" left="-1" />
    <xacro:leg name="rear_left" front="-1" left="1" />
    <xacro:leg name="rear_right" front="-1" left="-1" />

    <!-- head assembly mount -->
    <joint name="head_assembly_mount_joint" type="fixed">
      <parent link="${name}" />
      <child link="head_assembly_mount" />
      <origin xyz="0.24797 0 0.0807" rpy="0 0.10074 0" />
    </joint>

    <link name="head_assembly_mount">
      <visual>
        <origin xyz="0 0 0" rpy="${0.5 * pi} 0 ${0.5 * pi}" />
        <geometry>
          <mesh
            filename="package://sfg_go2_description/mesh/head_assembly_mount.glb" />
        </geometry>
      </visual>
    </link>

    <!-- camera head -->
    <xacro:intel_realsense_d435 name="camera_head" parent="head_assembly_mount">
      <origin xyz="0.06081 0.00001 0.00946" rpy="0 ${0.5 * pi} 0" />
    </xacro:intel_realsense_d435>

    <!-- tracker head -->
    <xacro:base_marker_tree name="tracker_head" parent="head_assembly_mount">
      <origin xyz="0 0 0.01396" rpy="0 0 0" />
    </xacro:base_marker_tree>

    <!-- extension dock -->
    <joint name="extension_dock_joint" type="fixed">
      <parent link="${name}" />
      <child link="extension_dock" />
      <origin xyz="-0.01896 0 0.05699" rpy="0 0 0" />
    </joint>

    <link name="extension_dock">
      <visual>
        <origin xyz="0 0 0" rpy="${0.5 * pi} 0 ${0.5 * pi}" />
        <geometry>
          <mesh filename="package://sfg_go2_description/mesh/extension_dock.glb" />
        </geometry>
      </visual>
    </link>

    <!-- lidar back -->
    <xacro:livox_mid360 name="lidar_back" parent="extension_dock">
      <origin xyz="-0.0531 0 0.0537" rpy="0 0 ${pi}" />
    </xacro:livox_mid360>
  </xacro:macro>
</robot>